# =============================================================
# FAN TRIBUTE — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# ---- App ----
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://fan_tribute_user:password@localhost:5432/fan_tribute
POSTGRES_PASSWORD=supersecretpassword

# ---- Redis ----
REDIS_URL=redis://:password@localhost:6379
REDIS_PASSWORD=redissecret

# ---- JWT ----
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_must_be_at_least_32_characters
JWT_REFRESH_EXPIRES=7d

# ---- AWS S3 ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=fan-tribute-media
AWS_CLOUDFRONT_DOMAIN=https://cdn.fantribute.com

# ---- Stripe (International payments) ----
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- MercadoPago (LATAM) ----
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_PUBLIC_KEY=APP_USR-...

# ---- Wompi (Colombia: PSE, Nequi, Daviplata) ----
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_EVENTS_KEY=...
WOMPI_INTEGRITY_SECRET=...

# ---- Firebase / Google Auth ----
FIREBASE_PROJECT_ID=fan-tribute-app
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@fan-tribute-app.iam.gserviceaccount.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---- Email (Resend) ----
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@fantribute.com
RESEND_FROM_NAME=FAN TRIBUTE

# ---- Google Analytics ----
GA4_MEASUREMENT_ID=G-...

# ---- Spotify API (artist integration) ----
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ---- Google Maps ----
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ---- pgAdmin (dev only) ----
PGADMIN_PASSWORD=pgadmin123
